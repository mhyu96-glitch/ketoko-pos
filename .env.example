# =====================================================================
# KETOKO POS — ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env jika ingin mengonfigurasi via file lokal,
# atau masukkan variabel ini di menu Settings Cloudflare Pages.
# =====================================================================

# 1. Supabase Project URL (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (Dapatkan dari Dashboard Supabase -> Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
