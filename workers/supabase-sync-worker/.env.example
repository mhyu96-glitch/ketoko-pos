# Salin file ini menjadi .dev.vars hanya untuk tes di komputer sendiri.
# Jangan masukkan .dev.vars ke Git.

# Supabase pertama (wajib)
NODE_URL_1=https://PROJECT_REF.supabase.co
NODE_KEY_1=SUPABASE_ANON_KEY

# Supabase berikutnya (opsional). Bisa dilanjutkan sampai nomor 15.
NODE_URL_2=
NODE_KEY_2=
NODE_URL_3=
NODE_KEY_3=

# Telegram
TELEGRAM_BOT_TOKEN=TOKEN_DARI_BOTFATHER
TELEGRAM_CHAT_ID=CHAT_ID_KAMU
TELEGRAM_WEBHOOK_SECRET=BUAT_TEKS_RAHASIA_SENDIRI

# Token untuk POST /trigger, GET /sync-history, dan POST /set-webhook
MANUAL_TRIGGER_TOKEN=BUAT_TOKEN_PANJANG_SENDIRI
