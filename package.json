{
  "name": "ketoko-pos",
  "version": "1.0.0",
  "description": "Ketoko POS - Sistem Kasir & Manajemen Toko Offline",
  "author": "Borneo Etam <dev@borneoetam.com>",
  "homepage": "https://borneoetam.com",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server.cjs",
    "online": "node server.cjs --tunnel",
    "seed:supabase": "node scripts/seedSupabase.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "admin:start": "electron electron/admin-main.cjs",
    "admin:dist:linux": "electron-builder --config electron/electron-builder-admin.json --linux AppImage",
    "admin:dist:win": "electron-builder --config electron/electron-builder-admin.json --win"
  },
  "build": {
    "appId": "com.borneoetam.ketokopos",
    "productName": "Ketoko POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "public/favicon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@types/sql.js": "^1.4.11",
    "dexie": "^4.0.11",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
